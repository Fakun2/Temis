FROM node:24-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache openssl

FROM base AS deps
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY apps/ai-service/package.json apps/ai-service/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ai-contracts/package.json packages/ai-contracts/package.json
COPY packages/ai-core/package.json packages/ai-core/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/integration-contracts/package.json packages/integration-contracts/package.json
RUN npm ci

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run db:generate
RUN npm run build --workspace @temis/database
RUN npm run build --workspace @temis/integration-contracts
RUN npm run build --workspace @temis/api
RUN npm prune --omit=dev

FROM base AS runner
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=3001

RUN addgroup -S nodejs && adduser -S temis -G nodejs

COPY --from=builder --chown=temis:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=temis:nodejs /app/package.json ./package.json
COPY --from=builder --chown=temis:nodejs /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=temis:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=temis:nodejs /app/packages/integration-contracts/package.json ./packages/integration-contracts/package.json
COPY --from=builder --chown=temis:nodejs /app/packages/integration-contracts/dist ./packages/integration-contracts/dist
COPY --from=builder --chown=temis:nodejs /app/packages/ai-contracts/package.json ./packages/ai-contracts/package.json
COPY --from=builder --chown=temis:nodejs /app/packages/ai-contracts/dist ./packages/ai-contracts/dist
COPY --from=builder --chown=temis:nodejs /app/packages/ai-core/package.json ./packages/ai-core/package.json
COPY --from=builder --chown=temis:nodejs /app/packages/ai-core/dist ./packages/ai-core/dist
COPY --from=builder --chown=temis:nodejs /app/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=temis:nodejs /app/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=temis:nodejs /app/packages/database/prisma ./packages/database/prisma

USER temis
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:' + (process.env.API_PORT || 3001) + '/api/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
