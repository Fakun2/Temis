generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum MembershipStatus {
  invited
  active
  suspended
}

enum CaseNumberingMode {
  manual
  automatic
}

enum DocumentStorageMode {
  local
  s3
}

enum ClientType {
  human
  legal_entity
}

enum ClientStatus {
  active
  inactive
  archived
}

enum CaseInstance {
  first
  second
  third
}

enum CaseStatus {
  open
  paused
  closed
}

enum CaseTaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum CaseExpenseStatus {
  pending
  paid
  cancelled
  overdue
}

enum CaseParticipantRole {
  claimant
  defendant
  complainant
  accused
  third_party
  client
  opposing_party
  other
}

enum CaseParticipantKind {
  client
  opposing_party
  third_party
  other
}

enum CaseCatalogStrategy {
  manual
  center_forum
}

enum CaseHearingType {
  preliminary
  trial_view
  conciliation
  mediation
  testimonial
  confessional
  debate
  investigative_statement
  other
}

enum AiChatRunStatus {
  accepted
  failed
}

enum AiLegalDocumentType {
  constitution
  code
  law
  decree
  resolution
  jurisprudence
  doctrine
  other
}

enum AiLegalNormUnitType {
  preamble
  part
  book
  title
  chapter
  section
  article
  paragraph
  clause
  subsection
  other
}

enum AiEmbeddingStatus {
  pending
  embedded
  stale
  failed
}

enum FinanceCategoryKind {
  income
  expense
  both
}

enum CashboxMovementType {
  income
  expense
  conversion_in
  conversion_out
}

enum CaseExpenseCashboxSyncJobAction {
  upsert_cashbox_movement
  delete_cashbox_movement
}

enum CaseExpenseCashboxSyncJobStatus {
  pending
  processing
  completed
  failed
}

enum DocumentStorageCleanupJobStatus {
  pending
  processing
  completed
  failed
}

enum DocumentStorageCleanupJobReason {
  bulk_deleted
  case_deleted
  document_deleted
  folder_deleted
  metadata_create_failed
}

enum DocumentStatus {
  active
  deleting
}

enum DocumentImportJobStatus {
  pending
  processing
  completed
  partial_failed
  canceled
  failed
}

enum DocumentImportItemStatus {
  processing
  completed
  skipped_duplicate
  rejected
  failed
  canceled
}

enum NotificationReminderResourceType {
  case_task
  case_expense
  case_hearing
  meeting
}

enum NotificationRecipientMode {
  self
  tenant
  practice_area
  members
}

enum NotificationReminderStatus {
  pending
  processing
  delivered
  cancelled
  failed
}

enum NotificationRecipientStatus {
  pending
  delivered
  read
}

enum AsyncOutboxEventStatus {
  pending
  publishing
  published
  failed
}

model Tenant {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String
  legalName                  String?                     @map("legal_name")
  taxId                      String?                     @map("tax_id")
  status                     TenantStatus                @default(active)
  profile                    TenantProfile?
  settings                   TenantSettings?
  memberships                TenantMembership[]
  practiceAreas              PracticeArea[]
  clients                    Client[]
  cases                      Case[]
  caseTasks                  CaseTask[]
  caseExpenses               CaseExpense[]
  caseExpenseCashboxSyncJobs CaseExpenseCashboxSyncJob[]
  caseHearings               CaseHearing[]
  expenseAttachments         CaseExpenseAttachment[]
  documentFolders            DocumentFolder[]
  documentCategories         DocumentCategory[]
  documents                  Document[]
  documentImportJobs         DocumentImportJob[]
  documentImportItems        DocumentImportItem[]
  documentStorageCleanupJobs DocumentStorageCleanupJob[]
  aiChatRuns                 AiChatRun[]
  aiLegalDocuments           AiLegalDocument[]
  aiLegalVersions            AiLegalDocumentVersion[]
  aiLegalNormUnits           AiLegalNormUnit[]
  aiLegalNormChunks          AiLegalNormChunk[]
  roles                      Role[]
  tenantCurrencies           TenantCurrency[]
  financeCategories          TenantFinanceCategory[]
  cashboxMovements           CashboxMovement[]
  notificationReminders      NotificationReminder[]
  notificationRecipients     NotificationReminderRecipient[]
  asyncOutboxEvents          AsyncOutboxEvent[]
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  email                      String                      @unique
  fullName                   String                      @map("full_name")
  passwordHash               String                      @map("password_hash")
  dni                        String?
  phone                      String?
  emailVerifiedAt            DateTime?                   @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt                DateTime?                   @map("last_login_at") @db.Timestamptz(6)
  sessionVersion             Int                         @default(0) @map("session_version")
  status                     UserStatus                  @default(active)
  memberships                TenantMembership[]
  expenseAttachments         CaseExpenseAttachment[]
  documents                  Document[]
  documentImportJobs         DocumentImportJob[]
  cashboxMovements           CashboxMovement[]
  aiChatRuns                 AiChatRun[]
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  caseExpenseCashboxSyncJobs CaseExpenseCashboxSyncJob[]

  @@index([dni])
  @@map("users")
}

model TenantProfile {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  country           String
  province          String
  city              String
  address           String?
  website           String?
  logoUrl           String?  @map("logo_url")
  size              String?
  mainPracticeAreas String[] @default([]) @map("main_practice_areas")
  referralSource    String?  @map("referral_source")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model TenantSettings {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @unique @map("tenant_id") @db.Uuid
  timezone              String
  defaultCurrencyCode   String              @map("default_currency_code")
  defaultRoleForInvites String              @default("lawyer") @map("default_role_for_invites")
  caseNumberingMode     CaseNumberingMode   @default(manual) @map("case_numbering_mode")
  documentStorageMode   DocumentStorageMode @default(local) @map("document_storage_mode")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultCurrency Currency @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)

  @@map("tenant_settings")
}

model PracticeAreaTemplate {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  description   String?
  active        Boolean        @default(true)
  displayOrder  Int            @default(0) @map("display_order")
  practiceAreas PracticeArea[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, displayOrder])
  @@map("practice_area_templates")
}

model PracticeArea {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template              PracticeAreaTemplate?          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  membershipAssignments TenantMembershipPracticeArea[]
  cases                 Case[]

  @@unique([tenantId, name])
  @@unique([tenantId, templateId])
  @@index([tenantId])
  @@index([tenantId, active, name])
  @@index([templateId])
  @@map("practice_areas")
}

model Province {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique
  name                String
  province            String?
  country             String
  caseCatalogStrategy CaseCatalogStrategy @default(manual) @map("case_catalog_strategy")
  active              Boolean             @default(true)
  displayOrder        Int                 @default(0) @map("display_order")
  forumTemplates      ForumTemplate[]
  judicialCenters     JudicialCenter[]
  cases               Case[]
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, displayOrder])
  @@map("provinces")
}

model ForumTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  provinceId   String   @map("province_id") @db.Uuid
  code         String   @unique
  name         String
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  province             Province              @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  judicialCenterForums JudicialCenterForum[]
  cases                Case[]

  @@unique([provinceId, name])
  @@index([provinceId, active, displayOrder])
  @@map("forum_templates")
}

model JudicialCenter {
  id           String   @id @default(uuid()) @db.Uuid
  provinceId   String   @map("province_id") @db.Uuid
  code         String   @unique
  name         String
  active       Boolean  @default(true)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  province Province              @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  forums   JudicialCenterForum[]

  @@unique([provinceId, name])
  @@index([provinceId, active, displayOrder])
  @@map("judicial_centers")
}

model JudicialCenterForum {
  id               String   @id @default(uuid()) @db.Uuid
  judicialCenterId String   @map("judicial_center_id") @db.Uuid
  forumTemplateId  String   @map("forum_template_id") @db.Uuid
  active           Boolean  @default(true)
  displayOrder     Int      @default(0) @map("display_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  judicialCenter JudicialCenter @relation(fields: [judicialCenterId], references: [id], onDelete: Cascade)
  forumTemplate  ForumTemplate  @relation(fields: [forumTemplateId], references: [id], onDelete: Cascade)
  cases          Case[]

  @@unique([judicialCenterId, forumTemplateId])
  @@index([judicialCenterId, active, displayOrder])
  @@index([forumTemplateId, active])
  @@map("judicial_center_forums")
}

model Client {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  type             ClientType   @default(human)
  status           ClientStatus @default(active)
  firstName        String?      @map("first_name")
  lastName         String?      @map("last_name")
  age              Int?
  dni              String?
  cuil             String?
  cuit             String?
  businessName     String?      @map("business_name")
  email            String?
  phone            String?
  address          String?
  notes            String?
  statute          String?
  salaryReceiptRef String?      @map("salary_receipt_ref")
  cbu              String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryCases       Case[]            @relation("CasePrimaryClient")
  caseParticipations CaseParticipant[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, dni])
  @@index([tenantId, cuil])
  @@index([tenantId, cuit])
  @@index([tenantId, businessName])
  @@index([tenantId, lastName, firstName])
  @@map("clients")
}

model Case {
  id                      String       @id @default(uuid()) @db.Uuid
  tenantId                String       @map("tenant_id") @db.Uuid
  caseNumber              String       @map("case_number")
  caption                 String
  subject                 String?
  description             String?
  provinceId              String       @map("province_id") @db.Uuid
  forumTemplateId         String       @map("forum_template_id") @db.Uuid
  judicialCenterForumId   String?      @map("judicial_center_forum_id") @db.Uuid
  judicialCenterText      String?      @map("judicial_center_text")
  court                   String?
  instance                CaseInstance @default(first)
  status                  CaseStatus   @default(open)
  filingDate              DateTime?    @map("filing_date") @db.Date
  primaryClientId         String?      @map("primary_client_id") @db.Uuid
  practiceAreaId          String?      @map("practice_area_id") @db.Uuid
  responsibleMembershipId String?      @map("responsible_membership_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  province              Province                @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  forumTemplate         ForumTemplate           @relation(fields: [forumTemplateId], references: [id], onDelete: Restrict)
  judicialCenterForum   JudicialCenterForum?    @relation(fields: [judicialCenterForumId], references: [id], onDelete: SetNull)
  primaryClient         Client?                 @relation("CasePrimaryClient", fields: [primaryClientId], references: [id], onDelete: SetNull)
  practiceArea          PracticeArea?           @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  responsibleMembership TenantMembership?       @relation(fields: [responsibleMembershipId], references: [id], onDelete: SetNull)
  participants          CaseParticipant[]
  tasks                 CaseTask[]
  expenses              CaseExpense[]
  hearings              CaseHearing[]
  notificationReminders NotificationReminder[]
  expenseAttachments    CaseExpenseAttachment[]
  documents             Document[]
  aiChatRuns            AiChatRun[]

  @@unique([tenantId, caseNumber])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, caption])
  @@index([caseNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "cases_case_number_trgm_idx")
  @@index([caption(ops: raw("gin_trgm_ops"))], type: Gin, map: "cases_caption_trgm_idx")
  @@index([tenantId, filingDate])
  @@index([provinceId])
  @@index([forumTemplateId])
  @@index([judicialCenterForumId])
  @@index([primaryClientId])
  @@index([practiceAreaId])
  @@index([responsibleMembershipId])
  @@map("cases")
}

model DocumentCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, active, displayOrder])
  @@map("document_categories")
}

model DocumentFolder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("DocumentFolderHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Cascade)
  children  DocumentFolder[] @relation("DocumentFolderHierarchy")
  documents Document[]
  importJobs DocumentImportJob[]
  importItems DocumentImportItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, name])
  @@map("document_folders")
}

model Document {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  caseId           String?   @map("case_id") @db.Uuid
  folderId         String?   @map("folder_id") @db.Uuid
  categoryId       String?   @map("category_id") @db.Uuid
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  storageProvider  String    @map("storage_provider")
  bucket           String
  objectKey        String    @map("object_key")
  title            String
  originalName     String    @map("original_name")
  extension        String?
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  checksum         String?
  notes            String?
  status           DocumentStatus @default(active)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case           Case?                       @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  folder         DocumentFolder?             @relation(fields: [tenantId, folderId], references: [tenantId, id], onDelete: Restrict)
  category       DocumentCategory?           @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  uploadedByUser User                        @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  cleanupJobs    DocumentStorageCleanupJob[]
  importItems    DocumentImportItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([caseId])
  @@index([folderId])
  @@index([categoryId])
  @@index([uploadedByUserId])
  @@index([tenantId, caseId])
  @@index([tenantId, folderId])
  @@index([tenantId, folderId, createdAt])
  @@index([tenantId, caseId, createdAt])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@index([tenantId, mimeType])
  @@index([tenantId, title])
  @@index([tenantId, deletedAt])
  @@map("documents")
}

model DocumentImportJob {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  rootFolderId    String?                 @map("root_folder_id") @db.Uuid
  createdByUserId String                  @map("created_by_user_id") @db.Uuid
  status          DocumentImportJobStatus @default(pending)
  totalFiles      Int                     @default(0) @map("total_files")
  totalBytes      Int                     @default(0) @map("total_bytes")
  processedFiles  Int                     @default(0) @map("processed_files")
  completedFiles  Int                     @default(0) @map("completed_files")
  skippedFiles    Int                     @default(0) @map("skipped_files")
  rejectedFiles   Int                     @default(0) @map("rejected_files")
  failedFiles     Int                     @default(0) @map("failed_files")
  lastError       String?                 @map("last_error")
  startedAt       DateTime?               @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?               @map("completed_at") @db.Timestamptz(6)
  canceledAt      DateTime?               @map("canceled_at") @db.Timestamptz(6)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rootFolder    DocumentFolder?  @relation(fields: [tenantId, rootFolderId], references: [tenantId, id], onDelete: SetNull)
  createdByUser User            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         DocumentImportItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([rootFolderId])
  @@index([createdByUserId])
  @@map("document_import_jobs")
}

model DocumentImportItem {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                   @map("tenant_id") @db.Uuid
  importJobId String                   @map("import_job_id") @db.Uuid
  folderId    String?                  @map("folder_id") @db.Uuid
  documentId  String?                  @map("document_id") @db.Uuid
  relativePath String                  @map("relative_path")
  originalName String                  @map("original_name")
  mimeType    String                   @map("mime_type")
  sizeBytes   Int                      @map("size_bytes")
  checksum    String?
  status      DocumentImportItemStatus
  error       String?
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importJob DocumentImportJob @relation(fields: [tenantId, importJobId], references: [tenantId, id], onDelete: Cascade)
  folder    DocumentFolder?   @relation(fields: [tenantId, folderId], references: [tenantId, id], onDelete: SetNull)
  document  Document?         @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, importJobId, relativePath])
  @@index([tenantId])
  @@index([tenantId, importJobId])
  @@index([tenantId, status])
  @@index([folderId])
  @@index([documentId])
  @@map("document_import_items")
}

model DocumentStorageCleanupJob {
  id              String                          @id @default(uuid()) @db.Uuid
  tenantId        String                          @map("tenant_id") @db.Uuid
  documentId      String?                         @map("document_id") @db.Uuid
  storageProvider String                          @map("storage_provider")
  bucket          String
  objectKey       String                          @map("object_key")
  reason          DocumentStorageCleanupJobReason
  status          DocumentStorageCleanupJobStatus @default(pending)
  attempts        Int                             @default(0)
  nextRunAt       DateTime                        @default(now()) @map("next_run_at") @db.Timestamptz(6)
  lastError       String?                         @map("last_error")
  completedAt     DateTime?                       @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([storageProvider, bucket, objectKey])
  @@index([status, nextRunAt])
  @@index([tenantId, status])
  @@index([documentId])
  @@index([tenantId, documentId])
  @@map("document_storage_cleanup_jobs")
}

model AiChatRun {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
