FROM node:24-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache openssl

FROM base AS deps
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY apps/ai-service/package.json apps/ai-service/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/integration-contracts/package.json packages/integration-contracts/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ai-contracts/package.json packages/ai-contracts/package.json
COPY packages/ai-core/package.json packages/ai-core/package.json
COPY packages/database/package.json packages/database/package.json
RUN npm ci

FROM deps AS builder
COPY . .
RUN npm run db:generate
RUN npm run build --workspace @bogaap/integration-contracts
RUN npm run build --workspace @bogaap/worker

FROM base AS runtime-deps
COPY apps/worker/package.json ./package.json
COPY --from=builder /app/packages/integration-contracts ./packages/integration-contracts
RUN npm pkg set dependencies.@bogaap/integration-contracts="file:packages/integration-contracts"
RUN npm install --omit=dev --ignore-scripts

FROM base AS runner
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=256

RUN addgroup -S nodejs && adduser -S bogaap -G nodejs

COPY --from=runtime-deps --chown=bogaap:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=bogaap:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=bogaap:nodejs /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder --chown=bogaap:nodejs /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder --chown=bogaap:nodejs /app/apps/worker/dist ./apps/worker/dist

USER bogaap
CMD ["node", "apps/worker/dist/index.js"]
