
# Copy this file to .env.production on the VPS and replace every CHANGE_ME value.

CONTAINER_PREFIX=justinia-prod

# Public URLs
PUBLIC_DOMAIN=example.com
FRONTEND_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://app.example.com/api
API_CORS_ALLOWED_ORIGINS=https://app.example.com

# PostgreSQL
POSTGRES_USER=bogaap
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=bogaap
DATABASE_POOL_TIMEOUT=20
API_DATABASE_CONNECTION_LIMIT=5
WORKER_DATABASE_CONNECTION_LIMIT=2

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_SECURE=true

# Google OAuth / Google Identity Services
# Use the same OAuth client id in both variables.
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API runtime
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
EXPENSE_OVERDUE_SCHEDULER_ENABLED=true
ATTACHMENT_UPLOAD_RATE_LIMIT_MAX=20
ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
DOCUMENT_UPLOAD_RATE_LIMIT_MAX=20
DOCUMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# Background jobs
RABBITMQ_USER=bogaap
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_BIND_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_BIND_HOST=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=bogaap.jobs
RABBITMQ_NOTIFICATIONS_QUEUE=bogaap.notifications
RABBITMQ_DOCUMENT_CLEANUP_QUEUE=bogaap.document-cleanup
RABBITMQ_PREFETCH=3
RABBITMQ_CONSUMER_RETRY_INTERVAL_MS=5000
ASYNC_OUTBOX_PUBLISHER_ENABLED=true
ASYNC_OUTBOX_PUBLISHER_INTERVAL_MS=5000
ASYNC_OUTBOX_PUBLISHER_BATCH_SIZE=25
ASYNC_OUTBOX_DATABASE_RETRY_ATTEMPTS=5
ASYNC_OUTBOX_DATABASE_RETRY_BASE_DELAY_MS=250
DOCUMENT_CLEANUP_INLINE_PROCESSING_ENABLED=false
DOCUMENT_CLEANUP_SCHEDULER_ENABLED=false
DOCUMENT_CLEANUP_RECOVERY_INTERVAL_MS=600000
NOTIFICATIONS_SCHEDULER_ENABLED=false

# Storage: self-hosted MinIO by default.
# Cloudflare R2 is also supported with STORAGE_DRIVER=r2, the account endpoint,
# STORAGE_REGION=auto and STORAGE_FORCE_PATH_STYLE=false.
STORAGE_DRIVER=minio
STORAGE_BUCKET=bogaap-prod
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY_ID=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true

# AI provider
# Use "preview" to keep mocked/non-provider AI behavior, or "openai-compatible"
# with an API key/model for real AI responses.
AI_PROVIDER=preview
AI_OPENAI_API_KEY=
OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_PROVIDER_NAME=openai
AI_OPENAI_MODEL=
AI_DEFAULT_MODEL=
AI_MODEL_JUSTINIA_LEGAL=
AI_MODEL_BOGAPP_LEGAL=
AI_MODEL_REASONING=
AI_MODEL_FAST=
AI_MAX_OUTPUT_TOKENS=
AI_TEMPERATURE=

# SAE Tucuman import
SAE_TUCUMAN_LOGIN_URL=
SAE_TUCUMAN_PROCEEDINGS_URL=
SAE_TUCUMAN_ORIGIN=
SAE_TUCUMAN_USER_AGENT=

# Container resource defaults
API_MEMORY_LIMIT=768m
API_CPUS=0.75
API_NODE_OPTIONS=--max-old-space-size=512
WEB_MEMORY_LIMIT=512m
WEB_CPUS=0.50
WEB_NODE_OPTIONS=--max-old-space-size=384
WORKER_MEMORY_LIMIT=384m
WORKER_CPUS=0.25
WORKER_NODE_OPTIONS=--max-old-space-size=256
RABBITMQ_MEMORY_LIMIT=384m
RABBITMQ_CPUS=0.20
MINIO_MEMORY_LIMIT=384m
MINIO_CPUS=0.20
NGINX_MEMORY_LIMIT=128m
NGINX_CPUS=0.10
